{
    "name": "endone777/roles",
    "description": "Powerful package for handling roles and permissions in Laravel.",
    "keywords": [
        "roles",
        "permissions",
        "acl",
        "auth",
        "laravel",
        "illuminate"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ultraware"
        },
        {
            "name": "Endone777"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Endone777\\Roles\\": "src/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Endone777\\Roles\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Endone777\\Roles\\RolesServiceProvider"
            ]
        }
    }
}
